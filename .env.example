# =========================================================
# freeeオート経理（体験版） 設定ファイルのひな形
#
# 使い方:
#   1. このファイルをコピーして「.env」という名前で保存する
#      （コマンド: copy .env.example .env ）
#   2. 下の4項目の「=」の右側を、自分の値に書き換える
#
# 注意:
#   .env は秘密情報です。人に共有したり、チャットや掲示板に
#   貼ったり、GitHubに上げたりしないでください。
# =========================================================

# Claude（AI判定）を使うためのAPIキー
# 取得先: https://console.anthropic.com/ の「API Keys」
# 「sk-ant-」で始まる文字列を貼り付ける
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# freeeアプリのID（Client ID）
# 取得先: freeeアプリストアの開発者向けアプリ管理画面
FREEE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# freeeアプリの秘密鍵（Client Secret）
# 取得先: 上と同じアプリ管理画面
FREEE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 対象の事業所ID（半角数字）
# freeeにログインしたときのURLの company_id= の後ろの数字
# わからない場合は、認証後に python freee_auth.py --companies で一覧表示できる
FREEE_COMPANY_ID=1234567
