# =====================================================================
# freeeオート経理（体験版）環境変数サンプル
# ---------------------------------------------------------------------
# このファイルをコピーして「.env」という名前で保存し、
# 各項目に自分の値を入れてください（当日、講義で一緒に取得します）。
#
#   コピー方法（PowerShell）:  copy .env.example .env
#
# ※ .env は秘密情報です。GitHubに上げたり人に共有したりしないこと。
#    （.gitignore で除外済みですが、念のため注意してください）
# =====================================================================

# --- Anthropic（Claude）APIキー -------------------------------------
# https://console.anthropic.com/ の「API Keys」で発行。sk-ant- で始まる文字列。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- freeeアプリの認証情報 ------------------------------------------
# freeeアプリストアの「アプリ管理」→自分で作ったアプリ の画面に表示されます。
FREEE_CLIENT_ID=あなたのClient_IDをここに
FREEE_CLIENT_SECRET=あなたのClient_Secretをここに

# --- 対象の事業所ID -------------------------------------------------
# freeeにログインし、対象事業所のトップページを開いたときの
# URL「https://secure.freee.co.jp/reports/... ?company_id=1234567」の数字部分。
# わからない場合は、初回認証後に「python freee_auth.py --companies」で一覧表示できます。
FREEE_COMPANY_ID=1234567
