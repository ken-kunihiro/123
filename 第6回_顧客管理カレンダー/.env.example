# Notion同期を使う場合のみ設定する（使わない場合はこのファイルは不要）
# このファイルを .env という名前でコピーして値を入れる（.env はgit管理外）

# Notionインテグレーションのトークン（https://www.notion.so/my-integrations で発行）
NOTION_TOKEN=secret_xxxxxxxxxxxx

# 顧問先データベースのID（NotionのDB URLに含まれる32桁の英数字）
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ミーティング議事録データベースのID（任意。未設定なら議事録同期はスキップ）
# NOTION_MEETING_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
